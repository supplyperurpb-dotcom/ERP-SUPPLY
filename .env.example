# === Supabase ===
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave de servicio: SOLO uso en servidor (server actions / route handlers). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Base de datos (Postgres de Supabase, usado por Prisma) ===
# Panel de Supabase > Project Settings > Database > Connection string
# Pooler (pgbouncer) para queries en runtime serverless. connection_limit
# controla cuántas conexiones puede abrir a la vez ESTE proceso de Prisma
# (no el pool de PgBouncer en sí) — con 1, cualquier página que dispare
# varias queries en paralelo (Promise.all) las termina sirviendo de a una,
# y si la latencia se acumula puede agotar el timeout del pool
# ("Timed out fetching a new connection"). 5 es suficiente para un solo
# proceso de Node (dev o un server tradicional); ver docs/DECISIONES-TECNICAS.md.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Conexión directa, usada solo para migraciones (prisma migrate):
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# === Supabase Storage ===
# Nombre del bucket donde se guardan fotos de tarjas, PDFs de guías y packing lists
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documentos

# === App ===
# URL pública de la app (usada para generar enlaces en correos de Supabase Auth, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
