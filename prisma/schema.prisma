// Schema inicial (fase de scaffold) del sistema de gestión para productora
// y exportadora de arándanos. Ver docs/DECISIONES-TECNICAS.md para el
// razonamiento detrás de las decisiones tomadas en este modelo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum RolNombre {
  ADMIN
  LOGISTICA_COMPRAS
  ACOPIO
  COMEX
  APROBADOR
  SOLO_LECTURA
}

enum AccionPermiso {
  VER
  CREAR
  EDITAR
  APROBAR
  ELIMINAR
}

enum TipoDocumentoIdentidad {
  RUC
  DNI
}

enum TipoProveedor {
  INSUMOS
  FUNDO
  AMBOS
  TRANSPORTE
  MATERIALES_EMPAQUE
  ALMACEN
}

enum TipoAlmacen {
  INSUMOS
  AGROQUIMICOS
  MATERIAL_EMPAQUE
  CAMARA_FRIO
  OTRO
}

enum TipoMovimientoStock {
  INGRESO
  SALIDA
  TRANSFERENCIA
}

enum EstadoDocumento {
  BORRADOR
  PENDIENTE
  APROBADO
  RECHAZADO
  ANULADO
}

enum TipoDocumentoAprobacion {
  SOLICITUD_PEDIDO
  ORDEN_COMPRA
}

enum EstadoAprobacionItem {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoGuiaRemision {
  REMITENTE
  TRANSPORTISTA
}

enum EstadoGuiaRemision {
  EMITIDA
  ANULADA
}

enum EstadoPallet {
  ABIERTO // sigue aceptando bandejas (no ha llegado a la capacidad máxima)
  CERRADO // llegó a la capacidad máxima o se cerró manualmente
}

enum EstadoEmbarque {
  PLANIFICADO
  EN_PROCESO
  EMBARCADO
  CERRADO
}

enum EstadoPackingList {
  BORRADOR
  EMITIDO
  ANULADO
}

// Origen de un pallet IQF: de qué lado del proceso vino el descarte. Un
// mismo pallet físico nunca mezcla ambos orígenes (ver PalletIQF), pero
// ambos aparecen juntos en la pantalla de Tarjas IQF.
enum OrigenPalletIQF {
  DESCARTE_CAMPO
  DESCARTE_PLANTA
}

// =========================================================================
// USUARIOS, ROLES Y PERMISOS
// =========================================================================

model Usuario {
  id             String       @id @default(cuid())
  supabaseAuthId String       @unique
  nombres        String
  apellidos      String
  email          String       @unique
  telefono       String?
  // Área a la que pertenece (Producción, RRHH, etc.). Nulo = sin
  // restricción de área (p. ej. un ADMIN, o el usuario creado manualmente
  // antes de que existiera este campo). Se usa para que las listas de
  // Solicitudes de pedido y Órdenes de compra/servicio solo muestren los
  // documentos de su propia área, sea o no aprobador.
  area           AreaEmpresa?
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  asignacionesRol AsignacionRol[]
  logsAuditoria   LogAuditoria[]

  @@map("usuarios")
}

model Rol {
  id          String    @id @default(cuid())
  nombre      RolNombre @unique
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asignaciones     AsignacionRol[]
  permisos         Permiso[]
  reglasAprobacion ReglaAprobacion[]

  @@map("roles")
}

model Permiso {
  id     String        @id @default(cuid())
  rolId  String
  modulo String // "logistica" | "acopio" | "comex" | "usuarios"
  accion AccionPermiso

  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([rolId, modulo, accion])
  @@map("permisos")
}

model AsignacionRol {
  id            String   @id @default(cuid())
  usuarioId     String
  rolId         String
  asignadoPorId String?
  createdAt     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId])
  @@map("asignaciones_rol")
}

// =========================================================================
// PROVEEDORES (insumos y/o fundos proveedores de fruta)
// =========================================================================

model Proveedor {
  id              String                 @id @default(cuid())
  tipoDocumento   TipoDocumentoIdentidad
  numeroDocumento String
  razonSocial     String
  nombreComercial String?
  tipo            TipoProveedor
  direccion       String?
  distrito        String?
  provincia       String?
  departamento    String?
  telefono        String?
  email           String?
  contactoNombre  String?
  activo          Boolean                @default(true)
  creadoPorId     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  ordenesCompra   OrdenCompra[]
  ingresosFruta   IngresoFruta[]
  ingresosIQF     IngresoIQF[]
  ingresosAlmacen IngresoAlmacen[]

  @@unique([tipoDocumento, numeroDocumento])
  @@map("proveedores")
}

// =========================================================================
// LOGÍSTICA / COMPRAS / ABASTECIMIENTO
// =========================================================================

model Sku {
  id           String   @id @default(cuid())
  codigo       String   @unique
  descripcion  String
  categoria    String
  subfamilia   String
  unidadMedida String // catálogo SUNAT simplificado (KGM, NIU, BX, LTR, ...)
  stockMinimo  Decimal? @db.Decimal(12, 3)
  activo       Boolean  @default(true)
  creadoPorId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimientosStock     MovimientoStock[]
  solicitudPedidoItem  SolicitudPedidoItem[]
  ordenCompraItem      OrdenCompraItem[]
  stockCamara          StockCamara[]
  ingresoAlmacenItems  IngresoAlmacenItem[]
  trasladoAlmacenItems TrasladoAlmacenItem[]
  consumoAlmacenItems  ConsumoAlmacenItem[]

  @@map("skus")
}

model Almacen {
  id        String      @id @default(cuid())
  codigo    String      @unique
  nombre    String
  tipo      TipoAlmacen
  ubicacion String?
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  movimientosOrigen  MovimientoStock[] @relation("MovimientoOrigen")
  movimientosDestino MovimientoStock[] @relation("MovimientoDestino")
  stockCamara        StockCamara[]
  ingresosAlmacen    IngresoAlmacen[]  @relation("IngresosAlmacen")
  trasladosOrigen    TrasladoAlmacen[] @relation("TrasladosOrigen")
  trasladosDestino   TrasladoAlmacen[] @relation("TrasladosDestino")
  consumosAlmacen    ConsumoAlmacen[]  @relation("ConsumosAlmacen")

  @@map("almacenes")
}

model MovimientoStock {
  id                  String              @id @default(cuid())
  skuId               String
  almacenOrigenId     String?
  almacenDestinoId    String?
  tipo                TipoMovimientoStock
  cantidad            Decimal             @db.Decimal(12, 3)
  unidadMedida        String
  documentoOrigenTipo String? // referencia polimórfica simple, ej. "ORDEN_COMPRA" | "INGRESO_FRUTA"
  documentoOrigenId   String?
  fecha               DateTime            @default(now())
  observaciones       String?
  creadoPorId         String?
  createdAt           DateTime            @default(now())

  sku            Sku      @relation(fields: [skuId], references: [id])
  almacenOrigen  Almacen? @relation("MovimientoOrigen", fields: [almacenOrigenId], references: [id])
  almacenDestino Almacen? @relation("MovimientoDestino", fields: [almacenDestinoId], references: [id])

  @@map("movimientos_stock")
}

// Área solicitante de una SolicitudPedido y centro de costo de cada línea
// (misma lista de valores para ambos conceptos, ver lib/constants/compras.ts).
enum AreaEmpresa {
  PRODUCCION
  SUPPLY_CHAIN
  FINANZAS
  GERENCIA_GENERAL
  SERVICIOS_GENERALES
  RRHH
}

enum TipoNecesidad {
  URGENTE
  ESTANDAR
}

// COMPRA y SERVICIO son categorías independientes con su propia serie de
// numeración (SP-/SS- para la solicitud, OC-/OS- para la orden) y no se
// pueden mezclar dentro de un mismo documento: una OC solo jala items de
// solicitudes COMPRA, una OS solo de solicitudes SERVICIO.
enum CategoriaCompra {
  COMPRA
  SERVICIO
}

model SolicitudPedido {
  id             String          @id @default(cuid())
  numero         String          @unique // serie-número interno, ej. SP-000000001 / SS-000000001
  categoria      CategoriaCompra @default(COMPRA)
  solicitanteId  String?
  area           AreaEmpresa
  estado         EstadoDocumento @default(BORRADOR)
  fecha          DateTime        @default(now())
  fechaNecesidad DateTime
  tipoNecesidad  TipoNecesidad   @default(ESTANDAR)
  justificacion  String?
  creadoPorId    String?
  // Decisión de aprobación: la toma el usuario configurado en AprobadorArea
  // para el área de la solicitud (o un ADMIN). Solo las solicitudes
  // APROBADO pueden jalarse hacia una Orden de Compra (ver
  // calcularSolicitudesConPendientes en lib/compras.ts).
  aprobadoPorId     String?
  fechaAprobacion   DateTime?
  comentarioRechazo String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items SolicitudPedidoItem[]

  @@map("solicitudes_pedido")
}

// Usuario responsable de aprobar las solicitudes de pedido de un área
// (p. ej. el Gerente de Producción aprueba las de PRODUCCION). Un área
// tiene como máximo un aprobador configurado a la vez.
model AprobadorArea {
  id        String      @id @default(cuid())
  area      AreaEmpresa @unique
  usuarioId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("aprobadores_area")
}

model SolicitudPedidoItem {
  id                String      @id @default(cuid())
  solicitudPedidoId String
  skuId             String
  cantidad          Decimal     @db.Decimal(12, 3)
  unidadMedida      String
  centroCosto       AreaEmpresa
  observaciones     String?

  solicitudPedido  SolicitudPedido   @relation(fields: [solicitudPedidoId], references: [id], onDelete: Cascade)
  sku              Sku               @relation(fields: [skuId], references: [id])
  ordenCompraItems OrdenCompraItem[]

  @@map("solicitud_pedido_items")
}

model OrdenCompra {
  id          String          @id @default(cuid())
  numero      String          @unique // serie-número interno, ej. OC-000000001 / OS-000000001
  categoria   CategoriaCompra @default(COMPRA)
  proveedorId String
  estado      EstadoDocumento @default(BORRADOR)
  fecha       DateTime        @default(now())
  // Una sola moneda para toda la OC (ver lib/constants/moneda.ts).
  moneda      String          @default("PEN")
  // subtotal = suma de subtotal de todas las líneas (gravadas y no
  // gravadas). igv = 18% solo de las líneas gravadas. montoTotal =
  // subtotal + igv.
  subtotal    Decimal         @default(0) @db.Decimal(12, 2)
  igv         Decimal         @default(0) @db.Decimal(12, 2)
  montoTotal  Decimal         @default(0) @db.Decimal(12, 2)
  creadoPorId String?
  // Decisión de aprobación (visto bueno): como una OC/OS puede jalar
  // líneas de varias áreas a la vez, la aprueba un ADMIN (no hay un único
  // aprobador de área que aplique siempre), a diferencia de SolicitudPedido.
  aprobadoPorId     String?
  fechaAprobacion   DateTime?
  comentarioRechazo String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  proveedor Proveedor         @relation(fields: [proveedorId], references: [id])
  items     OrdenCompraItem[]

  @@map("ordenes_compra")
}

model OrdenCompraItem {
  id                    String      @id @default(cuid())
  ordenCompraId         String
  // De qué línea de qué solicitud de pedido se "jaló" esta línea (ver
  // calcularPendientesSolicitudes en lib/compras.ts: la cantidad pendiente
  // de un SolicitudPedidoItem es su cantidad menos la suma de
  // OrdenCompraItem.cantidad de todas las OC no rechazadas/anuladas que
  // apuntan a él).
  solicitudPedidoItemId String?
  skuId                 String
  cantidad              Decimal     @db.Decimal(12, 3)
  precioUnitario        Decimal     @db.Decimal(12, 2)
  subtotal              Decimal     @db.Decimal(12, 2)
  // Si el producto está gravado con IGV. Se precarga desde la solicitud
  // pero se puede editar en la OC.
  gravado               Boolean     @default(true)
  centroCosto           AreaEmpresa

  ordenCompra         OrdenCompra          @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  solicitudPedidoItem SolicitudPedidoItem? @relation(fields: [solicitudPedidoItemId], references: [id])
  sku                 Sku                  @relation(fields: [skuId], references: [id])

  @@map("orden_compra_items")
}

// =========================================================================
// ALMACENES: ingresos, traslados y consumos
//
// Cada documento (cabecera + items) es el registro "de negocio" (guía,
// proveedor, precios, etc.). Cada item además genera una fila en
// MovimientoStock (con documentoOrigenTipo = "INGRESO_ALMACEN" |
// "TRASLADO_ALMACEN" | "CONSUMO_ALMACEN") que es la única fuente de verdad
// para calcular el stock por almacén+SKU (suma de ingresos y transferencias
// entrantes, menos salidas y transferencias salientes).
// =========================================================================

model IngresoAlmacen {
  id            String   @id @default(cuid())
  numero        String   @unique // IA-0001
  fecha         DateTime
  ocNumero      String?
  guiaRemision  String?
  remitenteRuc  String?
  remitente     String?
  proveedorId   String?
  almacenId     String
  // Moneda en la que se pactó/registró este ingreso ("PEN" | "USD"). Los
  // montos de precioUnitario/subtotal/flete se guardan en ESTA moneda (lo
  // que dice la factura/guía); el costeo del stock usa su equivalente en
  // USD (ver *Usd en IngresoAlmacenItem y convertirAUsd en
  // lib/constants/moneda.ts).
  moneda        String   @default("PEN")
  // Costo del transporte de este ingreso, en la moneda de arriba,
  // prorrateado entre los items según su participación en el subtotal (ver
  // crearIngresoAlmacenAction). Se suma al costo del producto para el
  // costeo ponderado del stock (ver mapaCostosAlmacen en
  // lib/stock-almacen.ts).
  flete         Decimal? @db.Decimal(12, 2)
  observaciones String?
  creadoPorId   String?
  createdAt     DateTime @default(now())

  proveedor Proveedor?           @relation(fields: [proveedorId], references: [id])
  almacen   Almacen              @relation("IngresosAlmacen", fields: [almacenId], references: [id])
  items     IngresoAlmacenItem[]

  @@map("ingresos_almacen")
}

model IngresoAlmacenItem {
  id                String  @id @default(cuid())
  ingresoAlmacenId  String
  skuId             String
  cantidad          Decimal @db.Decimal(12, 3)
  unidadMedida      String
  // precioUnitario/subtotal/fleteAsignado: en la moneda del ingreso (lo que
  // dice la factura). *Usd: el mismo monto convertido a Dólares (tipo de
  // cambio fijo, ver convertirAUsd) — es lo que usa el costeo del stock
  // (mapaCostosAlmacen), para que un mismo producto no mezcle Soles y
  // Dólares entre distintos ingresos.
  precioUnitario    Decimal @db.Decimal(12, 4)
  subtotal          Decimal @db.Decimal(14, 4)
  precioUnitarioUsd Decimal @db.Decimal(12, 4)
  subtotalUsd       Decimal @db.Decimal(14, 4)
  fleteAsignado     Decimal @default(0) @db.Decimal(14, 4)
  fleteAsignadoUsd  Decimal @default(0) @db.Decimal(14, 4)
  lote              String?

  ingresoAlmacen IngresoAlmacen @relation(fields: [ingresoAlmacenId], references: [id], onDelete: Cascade)
  sku            Sku            @relation(fields: [skuId], references: [id])

  @@map("ingreso_almacen_items")
}

model TrasladoAlmacen {
  id               String   @id @default(cuid())
  numero           String   @unique // TA-0001
  fecha            DateTime
  almacenOrigenId  String
  almacenDestinoId String
  guiaRemision     String?
  remitenteRuc     String?
  remitente        String?
  // Moneda del precio del flete de este traslado ("PEN" | "USD"). El costeo
  // del stock siempre usa el equivalente en Dólares (ver fleteAsignadoUsd en
  // TrasladoAlmacenItem y convertirAUsd en lib/constants/moneda.ts).
  moneda           String   @default("PEN")
  // Costo del transporte de este traslado, en la moneda de arriba,
  // prorrateado entre los items según su valor (ver
  // crearTrasladoAlmacenAction). Se suma al costo que el producto ya traía
  // del origen para el costeo ponderado del almacén de destino (ver
  // mapaCostosAlmacen en lib/stock-almacen.ts).
  flete            Decimal? @db.Decimal(12, 2)
  observaciones    String?
  creadoPorId      String?
  createdAt        DateTime @default(now())

  almacenOrigen  Almacen               @relation("TrasladosOrigen", fields: [almacenOrigenId], references: [id])
  almacenDestino Almacen               @relation("TrasladosDestino", fields: [almacenDestinoId], references: [id])
  items          TrasladoAlmacenItem[]

  @@map("traslados_almacen")
}

model TrasladoAlmacenItem {
  id                String  @id @default(cuid())
  trasladoAlmacenId String
  skuId             String
  cantidad          Decimal @db.Decimal(12, 3)
  unidadMedida      String
  // Costo unitario ponderado del almacén de origen en el momento del
  // traslado (ver precioUnitarioPonderado en lib/stock-almacen.ts): el
  // producto "viaja" con ese costo, así que el almacén de destino lo suma a
  // su propio valor de inventario en vez de perder el costeo al moverse.
  costoUnitario     Decimal @db.Decimal(12, 4)
  valorTotal        Decimal @db.Decimal(14, 4)
  // Parte del flete del traslado que le corresponde a esta línea (prorrateo
  // por valorTotal), en la moneda del traslado. *Usd: convertido a Dólares,
  // usado por el costeo del almacén de DESTINO (mapaCostosAlmacen); el
  // almacén de origen no se ve afectado por el costo de sacar el producto.
  fleteAsignado     Decimal @default(0) @db.Decimal(14, 4)
  fleteAsignadoUsd  Decimal @default(0) @db.Decimal(14, 4)

  trasladoAlmacen TrasladoAlmacen @relation(fields: [trasladoAlmacenId], references: [id], onDelete: Cascade)
  sku             Sku             @relation(fields: [skuId], references: [id])

  @@map("traslado_almacen_items")
}

model ConsumoAlmacen {
  id              String   @id @default(cuid())
  numero          String   @unique // CA-0001
  fecha           DateTime
  almacenOrigenId String
  observaciones   String?
  creadoPorId     String?
  createdAt       DateTime @default(now())

  almacen Almacen              @relation("ConsumosAlmacen", fields: [almacenOrigenId], references: [id])
  items   ConsumoAlmacenItem[]

  @@map("consumos_almacen")
}

model ConsumoAlmacenItem {
  id                      String  @id @default(cuid())
  consumoAlmacenId        String
  skuId                   String
  cantidad                Decimal @db.Decimal(12, 3)
  unidadMedida            String
  precioUnitarioPonderado Decimal @db.Decimal(12, 4)
  valorConsumido          Decimal @db.Decimal(14, 4)

  consumoAlmacen ConsumoAlmacen @relation(fields: [consumoAlmacenId], references: [id], onDelete: Cascade)
  sku            Sku            @relation(fields: [skuId], references: [id])

  @@map("consumo_almacen_items")
}

// =========================================================================
// APROBACIONES (config + historial, genérico por tipo de documento)
// =========================================================================

model ReglaAprobacion {
  id             String                  @id @default(cuid())
  tipoDocumento  TipoDocumentoAprobacion
  montoUmbral    Decimal?                @db.Decimal(12, 2)
  rolAprobadorId String
  orden          Int                     @default(1)
  activo         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  rolAprobador Rol @relation(fields: [rolAprobadorId], references: [id])

  @@map("reglas_aprobacion")
}

model Aprobacion {
  id              String                  @id @default(cuid())
  tipoDocumento   TipoDocumentoAprobacion
  documentoId     String
  documentoNumero String?
  aprobadorId     String?
  estado          EstadoAprobacionItem    @default(PENDIENTE)
  comentario      String?
  fecha           DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([tipoDocumento, documentoId])
  @@index([aprobadorId, estado])
  @@map("aprobaciones")
}

// =========================================================================
// ACOPIO
// =========================================================================

model TipoBandeja {
  id         String   @id @default(cuid())
  nombre     String   @unique
  pesoTaraKg Decimal  @db.Decimal(8, 3)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pallets   IngresoFrutaPallet[]
  lineasIQF IngresoIQFPallet[]

  @@map("tipos_bandeja")
}

model TipoPallet {
  id         String   @id @default(cuid())
  nombre     String   @unique
  pesoTaraKg Decimal  @db.Decimal(8, 3)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pallets   IngresoFrutaPallet[]
  lineasIQF IngresoIQFPallet[]

  @@map("tipos_pallet")
}

// Representa la llegada de un camión con materia prima: se registra una
// sola vez por camión (placa, hora de recepción) y agrupa una o más líneas
// de pesaje (IngresoFrutaPallet), porque un mismo camión puede traer fruta
// de varios módulos/turnos/variedades del fundo.
model IngresoFruta {
  id              String          @id @default(cuid())
  numero          String          @unique // ej. IF-0001
  proveedorId     String
  fechaCosecha    DateTime
  fechaIngreso    DateTime        @default(now())
  horaIngreso     String?
  placaTransporte String?
  observaciones   String?
  estado          EstadoDocumento @default(BORRADOR)
  creadoPorId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  proveedor     Proveedor            @relation(fields: [proveedorId], references: [id])
  pallets       IngresoFrutaPallet[]
  guiasRemision GuiaRemision[]

  @@map("ingresos_fruta")
}

// Pallet físico real (capacidad máxima fija de bandejas). Un pallet puede
// recibir bandejas de más de una línea de pesaje (incluso de distintos
// camiones), hasta llegar a CAPACIDAD_MAXIMA_BANDEJAS_POR_PALLET
// (ver lib/constants/pallet.ts). Los totales se guardan denormalizados
// (se actualizan en cada asignación) para no tener que re-agregar en cada
// lectura al mostrar la capacidad disponible.
model Pallet {
  id               String       @id @default(cuid())
  numero           String       @unique // ej. PAL-0001
  cantidadBandejas Int          @default(0)
  pesoBrutoTotalKg Decimal      @default(0) @db.Decimal(10, 3)
  pesoTaraTotalKg  Decimal      @default(0) @db.Decimal(10, 3)
  pesoNetoKg       Decimal      @default(0) @db.Decimal(10, 3)
  estado           EstadoPallet @default(ABIERTO)
  creadoPorId      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  lineas IngresoFrutaPallet[]
  tarja  Tarja?

  @@map("pallets")
}

// Una línea de pesaje: trazabilidad (módulo/turno/variedad) + cantidad de
// bandejas de un tipo, asignadas a UN pallet físico (`Pallet`, no
// `TipoPallet`, que es el catálogo de tipos de parihuela). Si un mismo
// camión trae bandejas para más de un pallet, se registra una línea por
// cada destino.
model IngresoFrutaPallet {
  id               String   @id @default(cuid())
  ingresoFrutaId   String
  numeroPallet     Int // correlativo de la línea dentro de este ingreso (no es el número del Pallet físico)
  // Exactamente uno de los dos está presente, según tipoProducto: las líneas
  // "Exportable" arman un Pallet normal; las líneas "Descarte Campo" arman
  // un PalletIQF (mismo pool físico que usa Ingreso IQF) para que su tarja
  // salga en Tarjas IQF en vez de en Tarjas. Ver PalletIQF.origen.
  palletId         String?
  palletIQFId      String?
  modulo           String // bloque/sector del fundo de origen de esta línea
  turno            String // sub-división del módulo (no es turno de trabajo)
  variedad         String
  formato          String // presentación/línea de proceso, ej. "Sweetest Batch"
  tipoProducto     String // ej. "Exportable" | "Descarte Campo"
  tipoPalletId     String? // opcional: catálogo de tipo de parihuela, no se usa en el cálculo de neto
  tipoBandejaId    String
  cantidadBandejas Int
  pesoBrutoTotalKg Decimal  @db.Decimal(10, 3)
  pesoTaraTotalKg  Decimal  @db.Decimal(10, 3)
  pesoNetoKg       Decimal  @db.Decimal(10, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingresoFruta IngresoFruta              @relation(fields: [ingresoFrutaId], references: [id], onDelete: Cascade)
  pallet       Pallet?                   @relation(fields: [palletId], references: [id])
  palletIQF    PalletIQF?                @relation(fields: [palletIQFId], references: [id])
  tipoPallet   TipoPallet?               @relation(fields: [tipoPalletId], references: [id])
  tipoBandeja  TipoBandeja               @relation(fields: [tipoBandejaId], references: [id])
  bandejas     IngresoFrutaBandejaPeso[]
  guiaDetalles GuiaRemisionDetalle[]

  @@unique([ingresoFrutaId, numeroPallet])
  @@map("ingreso_fruta_pallets")
}

model IngresoFrutaBandejaPeso {
  id            String  @id @default(cuid())
  palletId      String
  numeroBandeja Int
  pesoBrutoKg   Decimal @db.Decimal(8, 3)

  pallet IngresoFrutaPallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  @@unique([palletId, numeroBandeja])
  @@map("ingreso_fruta_bandeja_pesos")
}

// Etiqueta/ticket impreso de un pallet físico armado (no de una línea de
// pesaje individual): un pallet puede reunir bandejas de más de una línea
// (incluso de distintos camiones), y la tarja resume ese conjunto.
model Tarja {
  id           String   @id @default(cuid())
  numero       String   @unique // ej. RPB26-0001
  palletId     String   @unique
  fechaEmision DateTime @default(now())
  pdfUrl       String?
  creadoPorId  String?
  createdAt    DateTime @default(now())
  // Una vez despachada, la tarja (y su pallet) ya no está disponible para
  // un despacho futuro.
  despachoId   String?

  pallet   Pallet    @relation(fields: [palletId], references: [id])
  despacho Despacho? @relation(fields: [despachoId], references: [id])

  @@map("tarjas")
}

// Despacho de pallets ya armados y con tarja generada (p. ej. hacia la
// planta de proceso o para preparar un embarque). Al despachar, las tarjas
// seleccionadas quedan vinculadas a este registro y dejan de estar
// disponibles para un despacho futuro.
model Despacho {
  id                 String   @id @default(cuid())
  numero             String   @unique // ej. DESP-0001
  placaCamion        String
  conductor          String
  fechaDespacho      DateTime
  horaDespacho       String?
  numeroGuiaRemision String? // guía de remisión física del transportista, no la de GuiaRemision (SUNAT)
  creadoPorId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tarjas Tarja[]

  @@map("despachos")
}

model GuiaRemision {
  id                       String             @id @default(cuid())
  serie                    String
  numero                   String
  tipoGuia                 TipoGuiaRemision
  motivoTraslado           String
  fechaTraslado            DateTime
  puntoPartida             String
  puntoLlegada             String
  pesoBrutoTotalKg         Decimal            @db.Decimal(10, 3)
  unidadMedidaPeso         String             @default("KGM")
  transportistaRazonSocial String?
  transportistaDocumento   String?
  placaVehiculo            String?
  licenciaConductor        String?
  conductorNombre          String?
  conductorDocumento       String?
  ingresoFrutaId           String
  estado                   EstadoGuiaRemision @default(EMITIDA)
  pdfUrl                   String?
  creadoPorId              String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  ingresoFruta IngresoFruta          @relation(fields: [ingresoFrutaId], references: [id])
  detalles     GuiaRemisionDetalle[]

  @@unique([serie, numero])
  @@map("guias_remision")
}

model GuiaRemisionDetalle {
  id             String  @id @default(cuid())
  guiaRemisionId String
  palletId       String
  descripcion    String?
  cantidadBultos Int?
  pesoKg         Decimal @db.Decimal(10, 3)

  guiaRemision GuiaRemision       @relation(fields: [guiaRemisionId], references: [id], onDelete: Cascade)
  pallet       IngresoFrutaPallet @relation(fields: [palletId], references: [id])

  @@map("guia_remision_detalles")
}

// =========================================================================
// ACOPIO — INGRESO IQF (descarte de planta)
// =========================================================================
// Flujo paralelo e independiente al de Ingreso de Materia Prima: mismos
// datos generales de camión, pero sin módulo/turno/formato por línea (el
// descarte de planta no se organiza por bloque de fundo) y con el tipo de
// producto fijo en "Descarte Planta". Usa sus propios Pallet/Tarja/Despacho
// para no mezclar sus números ni sus listados con los de fruta.

model IngresoIQF {
  id              String          @id @default(cuid())
  numero          String          @unique // ej. IQF-0001
  proveedorId     String
  fechaCosecha    DateTime
  fechaIngreso    DateTime        @default(now())
  horaIngreso     String?
  placaTransporte String?
  observaciones   String?
  estado          EstadoDocumento @default(BORRADOR)
  creadoPorId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  proveedor Proveedor          @relation(fields: [proveedorId], references: [id])
  pallets   IngresoIQFPallet[]

  @@map("ingresos_iqf")
}

model PalletIQF {
  id               String          @id @default(cuid())
  numero           String          @unique // ej. PIQF-0001
  // De qué lado vino el descarte que arma este pallet: nunca se mezclan (un
  // pallet es 100% Descarte Campo -líneas de Ingreso de Materia Prima- o
  // 100% Descarte Planta -líneas de Ingreso IQF-), aunque ambos orígenes
  // comparten la misma numeración y aparecen juntos en Tarjas IQF.
  origen           OrigenPalletIQF
  cantidadBandejas Int             @default(0)
  pesoBrutoTotalKg Decimal         @default(0) @db.Decimal(10, 3)
  pesoTaraTotalKg  Decimal         @default(0) @db.Decimal(10, 3)
  pesoNetoKg       Decimal         @default(0) @db.Decimal(10, 3)
  estado           EstadoPallet    @default(ABIERTO)
  creadoPorId      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lineas      IngresoIQFPallet[]
  lineasFruta IngresoFrutaPallet[]
  tarja       TarjaIQF?

  @@map("pallets_iqf")
}

// Línea de pesaje de Ingreso IQF: sin modulo/turno/formato (a diferencia de
// IngresoFrutaPallet); tipoProducto queda fijo en "Descarte Planta" desde el
// server action, no es elegible en el formulario.
model IngresoIQFPallet {
  id               String   @id @default(cuid())
  ingresoIQFId     String
  numeroPallet     Int // correlativo de la línea dentro de este ingreso
  palletId         String
  variedad         String
  tipoProducto     String // fijo: "Descarte Planta"
  tipoPalletId     String?
  tipoBandejaId    String
  cantidadBandejas Int
  pesoBrutoTotalKg Decimal  @db.Decimal(10, 3)
  pesoTaraTotalKg  Decimal  @db.Decimal(10, 3)
  pesoNetoKg       Decimal  @db.Decimal(10, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingresoIQF  IngresoIQF  @relation(fields: [ingresoIQFId], references: [id], onDelete: Cascade)
  pallet      PalletIQF   @relation(fields: [palletId], references: [id])
  tipoPallet  TipoPallet? @relation(fields: [tipoPalletId], references: [id])
  tipoBandeja TipoBandeja @relation(fields: [tipoBandejaId], references: [id])

  @@unique([ingresoIQFId, numeroPallet])
  @@map("ingreso_iqf_pallets")
}

model TarjaIQF {
  id           String   @id @default(cuid())
  numero       String   @unique // ej. IQF26-0001
  palletId     String   @unique
  fechaEmision DateTime @default(now())
  pdfUrl       String?
  creadoPorId  String?
  createdAt    DateTime @default(now())
  despachoId   String?

  pallet   PalletIQF    @relation(fields: [palletId], references: [id])
  despacho DespachoIQF? @relation(fields: [despachoId], references: [id])

  @@map("tarjas_iqf")
}

model DespachoIQF {
  id                 String   @id @default(cuid())
  numero             String   @unique // ej. DESPIQF-0001
  placaCamion        String
  conductor          String
  fechaDespacho      DateTime
  horaDespacho       String?
  numeroGuiaRemision String? // guía de remisión física del transportista
  creadoPorId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tarjas TarjaIQF[]

  @@map("despachos_iqf")
}

// =========================================================================
// COMEX
// =========================================================================

model FormatoExportacion {
  id                String   @id @default(cuid())
  codigo            String   @unique
  nombre            String // ej. "Clamshell 125g", "6oz", "18oz", "Granel"
  pesoNetoUnitarioG Decimal? @db.Decimal(10, 2)
  unidadesPorCaja   Int?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockCamara      StockCamara[]
  packingListItems PackingListItem[]

  @@map("formatos_exportacion")
}

model Cliente {
  id                         String   @id @default(cuid())
  razonSocial                String
  pais                       String?
  numeroIdentificacionFiscal String?
  contactoNombre             String?
  email                      String?
  telefono                   String?
  activo                     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  embarques   Embarque[]
  stockCamara StockCamara[]

  @@map("clientes")
}

model StockCamara {
  id                   String   @id @default(cuid())
  skuId                String?
  formatoExportacionId String
  almacenId            String
  lote                 String
  clienteId            String?
  cantidadDisponible   Decimal  @db.Decimal(12, 3)
  unidadMedida         String   @default("NIU")
  fechaIngreso         DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sku                Sku?               @relation(fields: [skuId], references: [id])
  formatoExportacion FormatoExportacion @relation(fields: [formatoExportacionId], references: [id])
  almacen            Almacen            @relation(fields: [almacenId], references: [id])
  cliente            Cliente?           @relation(fields: [clienteId], references: [id])

  @@index([formatoExportacionId, lote])
  @@map("stock_camara")
}

model Embarque {
  id            String         @id @default(cuid())
  numero        String         @unique // ej. EMB-0001
  fechaEmbarque DateTime?
  contenedor    String?
  naviera       String?
  destinoPais   String?
  destinoPuerto String?
  clienteId     String?
  estado        EstadoEmbarque @default(PLANIFICADO)
  creadoPorId   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  packingLists PackingList[]

  @@map("embarques")
}

model PackingList {
  id           String            @id @default(cuid())
  numero       String            @unique // ej. PL-0001
  embarqueId   String
  fechaEmision DateTime          @default(now())
  pdfUrl       String?
  estado       EstadoPackingList @default(BORRADOR)
  creadoPorId  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  embarque Embarque          @relation(fields: [embarqueId], references: [id])
  items    PackingListItem[]

  @@map("packing_lists")
}

model PackingListItem {
  id                   String  @id @default(cuid())
  packingListId        String
  formatoExportacionId String
  lote                 String?
  numeroPallet         String?
  cantidadCajas        Int
  pesoNetoKg           Decimal @db.Decimal(10, 3)
  pesoBrutoKg          Decimal @db.Decimal(10, 3)

  packingList        PackingList        @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  formatoExportacion FormatoExportacion @relation(fields: [formatoExportacionId], references: [id])

  @@map("packing_list_items")
}

// =========================================================================
// AUDITORÍA
// =========================================================================

model LogAuditoria {
  id             String   @id @default(cuid())
  usuarioId      String?
  accion         String // ej. "CREAR" | "EDITAR" | "APROBAR" | "RECHAZAR" | "ANULAR"
  entidad        String // nombre del modelo afectado
  entidadId      String
  valoresAntes   Json?
  valoresDespues Json?
  fecha          DateTime @default(now())
  ipAddress      String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@map("logs_auditoria")
}
